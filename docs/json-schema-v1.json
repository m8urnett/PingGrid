{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m8urnett/PingGrid/docs/json-schema-v1.json",
  "title": "PingGrid JSON output schema v1",
  "oneOf": [
    { "$ref": "#/$defs/singleSweep" },
    { "$ref": "#/$defs/multiSweep" }
  ],
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "status"],
      "properties": {
        "ip": { "type": "string" },
        "hostname": { "type": "string" },
        "status": { "enum": ["offline", "online", "highlight", "slow", "silent"] },
        "roles": {
          "type": "array",
          "items": { "enum": ["Me", "Gateway", "DNS", "DHCP"] },
          "uniqueItems": true
        },
        "rtt_ms": { "type": "number", "minimum": 0 },
        "mac": { "type": "string" },
        "vendor": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target", "scan_mode", "total_hosts", "online_hosts", "fast_hosts", "slow_hosts", "silent_hosts", "offline_hosts", "duration_ms", "width", "height", "rows", "cols"],
      "properties": {
        "schema_version": { "const": 1 },
        "target": { "type": "string" },
        "scan_mode": { "enum": ["icmp", "icmp_with_ping_and_tcp_fallback"] },
        "total_hosts": { "type": "integer", "minimum": 0 },
        "online_hosts": { "type": "integer", "minimum": 0 },
        "fast_hosts": { "type": "integer", "minimum": 0 },
        "slow_hosts": { "type": "integer", "minimum": 0 },
        "silent_hosts": { "type": "integer", "minimum": 0 },
        "offline_hosts": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "output_file": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "joined_hosts": { "type": "array", "items": { "type": "string" } },
        "dropped_hosts": { "type": "array", "items": { "type": "string" } },
        "hosts": { "type": "array", "items": { "$ref": "#/$defs/host" } }
      }
    },
    "singleSweep": {
      "allOf": [
        { "$ref": "#/$defs/summary" },
        { "required": ["hosts"] }
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "index", "primary", "target", "summary", "hosts"],
      "properties": {
        "name": { "type": "string" },
        "index": { "type": "integer" },
        "primary": { "type": "boolean" },
        "target": { "type": "string" },
        "ip": { "type": "string" },
        "gateway": { "type": "string" },
        "link_health": { "type": "object" },
        "summary": { "$ref": "#/$defs/summary" },
        "hosts": { "type": "array", "items": { "$ref": "#/$defs/host" } }
      }
    },
    "multiSweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "multi_interface", "interfaces_count", "total_hosts", "total_active", "total_fast", "total_slow", "total_silent", "total_offline", "duration_ms", "interfaces"],
      "properties": {
        "schema_version": { "const": 1 },
        "multi_interface": { "const": true },
        "interfaces_count": { "type": "integer", "minimum": 1 },
        "total_hosts": { "type": "integer", "minimum": 0 },
        "total_active": { "type": "integer", "minimum": 0 },
        "total_fast": { "type": "integer", "minimum": 0 },
        "total_slow": { "type": "integer", "minimum": 0 },
        "total_silent": { "type": "integer", "minimum": 0 },
        "total_offline": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } }
      }
    }
  }
}
